@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject HrmsClient Api
@inject PortalClient Portal
@inject AttendanceClient AttApi
@inject NavigationManager Nav

@if (!Auth.IsSignedIn)
{
    <div class="boot"><span class="spinner"></span></div>
}
else
{
<div class="shell">
    <NavMenu />

    <div class="main">
        <header class="topbar">
            <span class="topbar-logo"><Icon Name="users" Size="20" /> Growora HRMS</span>
            <label class="search">
                <Icon Name="search" Size="18" />
                <input type="text" placeholder="Search employees, leave, attendance, projects..." />
                <kbd>Ctrl + K</kbd>
            </label>
            <span class="grow"></span>
            <NotificationBell />
            <div class="user-wrap">
                <button type="button" class="user" @onclick="() => menu = !menu">
                    <Avatar Name="@Auth.User!.FullName" Size="40" />
                    <div class="user-meta"><strong>@Fmt.Title(Auth.User!.FullName)</strong><small>@Auth.User!.RoleName</small></div>
                    <Icon Name="chevron-down" Size="16" />
                </button>
                @if (menu)
                {
                    <div class="user-menu" @onclick="() => menu = false">
                        <div class="um-head"><strong>@Fmt.Title(Auth.User!.FullName)</strong><small>@Auth.User!.UserId | @Auth.User!.RoleName</small><small>@Auth.User!.Company | FY @Auth.User!.FinYear</small></div>
                        <button type="button" class="neutral" @onclick='() => Nav.NavigateTo("change-password")'><Icon Name="key" Size="16" /> Change password</button>
                        <button type="button" @onclick="SignOut"><Icon Name="logout" Size="16" /> Sign out</button>
                    </div>
                }
            </div>
        </header>

        <main class="content">
            <ErrorBoundary @ref="boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <section class="card state error">
                        <h3>Something went wrong on this screen</h3>
                        <p>@ex.Message</p>
                        <button type="button" class="btn primary" @onclick="() => boundary?.Recover()">Try again</button>
                    </section>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>

    <nav class="bottom-nav">
        <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" /><span>Home</span></NavLink>
        @if (Auth.Can(AuthState.EmployeeMaster)) { <NavLink href="employees"><Icon Name="users" /><span>Employees</span></NavLink> }
        @if (Auth.Can(AuthState.Leave)) { <NavLink href="leave"><Icon Name="calendar" /><span>Leave</span></NavLink> }
        @if (Auth.CanAny(AuthState.Grade, AuthState.Variable, AuthState.Loans, AuthState.Reports, "164")) { <NavLink href="payroll"><Icon Name="wallet" /><span>Payroll</span></NavLink> }
        <button type="button" class="nav-out" @onclick="() => more = true"><Icon Name="grid" /><span>More</span>@if (InboxBadge.Count > 0) { <b class="dot-count">@InboxBadge.Count</b> }</button>
    </nav>

    @if (more)
    {
        <div class="more-back" @onclick="() => more = false">
            <div class="more-sheet" @onclick:stopPropagation="true">
                <div class="more-grab"></div>
                <div class="more-head">
                    <Avatar Name="@Auth.User!.FullName" Size="44" />
                    <div><strong>@Fmt.Title(Auth.User!.FullName)</strong><small>@Auth.User!.UserId | @Auth.User!.RoleName</small><small>@Auth.User!.Company | FY @Auth.User!.FinYear</small></div>
                </div>
                <div class="more-grid" @onclick="() => more = false">
                    @foreach (var item in NavMenu.Items.Where(i => (i.Options is null || Auth.CanAny(i.Options)) && (i.Href != "my/ask" || Auth.User?.EmployeeCode is not null)))
                    {
                        <NavLink class="more-item" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><Icon Name="@item.Icon" Size="22" /><span>@item.Label</span>@if (item.Href == "approvals" && InboxBadge.Count > 0) { <b class="nav-count">@InboxBadge.Count</b> }</NavLink>
                    }
                    @foreach (var m in (Auth.User?.Menu ?? []).OrderBy(x => x.Sequence))
                    {
                        <NavLink class="more-item" href="@m.Route" Match="@(m.Route == "my" ? NavLinkMatch.All : NavLinkMatch.Prefix)"><Icon Name="@m.Icon" Size="22" /><span>@m.Name</span></NavLink>
                    }
                </div>
                <div class="more-actions">
                    <button type="button" class="btn ghost" @onclick='() => { more = false; Nav.NavigateTo("change-password"); }'><Icon Name="key" Size="16" /> Change password</button>
                    <button type="button" class="btn ghost danger" @onclick="SignOut"><Icon Name="logout" Size="16" /> Sign out</button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    ErrorBoundary? boundary;
    bool menu, more;

    protected override void OnInitialized()
    {
        Auth.Changed += OnAuthChanged;
        InboxBadge.Changed += OnBadge;
        if (!Auth.IsSignedIn) Nav.NavigateTo("login", replace: true);
        else if (Auth.User!.MustChange) Nav.NavigateTo("change-password", replace: true);
        else if (Auth.CanAny("H201", "H206")) _ = InboxBadge.Refresh(Portal, AttApi, Auth);
    }

    void OnBadge() => InvokeAsync(StateHasChanged);

    void OnAuthChanged() => InvokeAsync(() =>
    {
        if (!Auth.IsSignedIn) Nav.NavigateTo("login", replace: true);
        StateHasChanged();
    });

    async Task SignOut()
    {
        menu = more = false;
        InboxBadge.Reset();
        await Api.Logout();
        Auth.SignOut();
    }

    public void Dispose() { Auth.Changed -= OnAuthChanged; InboxBadge.Changed -= OnBadge; }

    protected override void OnParametersSet() => boundary?.Recover();
}
