@page "/change-password"
@layout EmptyLayout
@inject PortalClient Portal
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Change password</PageTitle>

<div class="login single">
    <section class="login-side">
        <form class="login-card" @onsubmit="Save" @onsubmit:preventDefault="true">
            <span class="login-logo"><Icon Name="key" Size="26" /></span>
            <h2>@(Forced ? "Set a new password" : "Change password")</h2>
            <p class="login-sub">@(Forced ? "You are using a temporary password. Choose your own before you continue." : "Choose a new password for your account.")</p>

            @if (error is not null) { <div class="login-error" role="alert">@error</div> }

            <label class="field"><span>Current password</span>
                <div class="input-ic"><Icon Name="lock" Size="18" /><input type="password" @bind="current" @bind:event="oninput" autocomplete="current-password" autofocus /></div></label>
            <label class="field"><span>New password</span>
                <div class="input-ic"><Icon Name="key" Size="18" /><input type="password" @bind="next" @bind:event="oninput" autocomplete="new-password" /></div></label>
            <label class="field"><span>Repeat new password</span>
                <div class="input-ic"><Icon Name="key" Size="18" /><input type="password" @bind="again" @bind:event="oninput" autocomplete="new-password" /></div></label>

            <ul class="pw-rules">
                <li class="@(next.Length >= 8 ? "ok" : "")">At least 8 characters</li>
                <li class="@(next.Any(char.IsLetter) ? "ok" : "")">A letter</li>
                <li class="@(next.Any(char.IsDigit) ? "ok" : "")">A number</li>
                <li class="@(next.Length > 0 && next == again ? "ok" : "")">Both entries match</li>
            </ul>

            <button type="submit" class="btn primary login-go" disabled="@busy">@(busy ? "Saving..." : "Save password")</button>
            @if (!Forced) { <button type="button" class="btn ghost" @onclick="Back">Cancel</button> }
            else { <button type="button" class="link plain" @onclick="SignOut">Sign out</button> }
        </form>
    </section>
</div>

@code {
    string current = "", next = "", again = "";
    bool busy;
    string? error;

    bool Forced => Auth.User?.MustChange == true;

    protected override void OnInitialized()
    {
        if (!Auth.IsSignedIn) Nav.NavigateTo("login", replace: true);
    }

    void Back() => Nav.NavigateTo(Auth.Landing);

    async Task SignOut() { Auth.SignOut(); await Task.CompletedTask; }

    async Task Save()
    {
        error = null;
        if (string.IsNullOrEmpty(current)) { error = "Enter your current password."; return; }
        if (next != again) { error = "The two new passwords are not the same."; return; }
        busy = true;
        var r = await Portal.ChangePassword(current, next);
        busy = false;
        if (!r.Ok) { error = r.Error; return; }
        Auth.PasswordChanged();
        Nav.NavigateTo(Auth.Landing, replace: true);
    }
}
