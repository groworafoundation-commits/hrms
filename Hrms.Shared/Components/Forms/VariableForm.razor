@inject HrmsClient Api

<form class="form" @onsubmit="Save">
    <div class="form-grid">
        <label class="field full"><span>Employee</span><EmployeePick @bind-Value="empCode" Disabled="@(Existing is not null || FixedEmp is not null)" /></label>
        <label class="field"><span>Type</span>
            <select @bind="type"><option value="">Select</option>@foreach (var t in types) { <option value="@t.Code">@t.Name</option> }</select></label>
        <label class="field"><span>Date</span><input type="date" @bind="date" /></label>
        <label class="field full"><span>Amount</span><input type="number" step="0.01" min="0" @bind="amount" /></label>
        <label class="field full"><span>Remarks</span><input type="text" @bind="remarks" /></label>
    </div>
    @if (error is not null) { <div class="form-error">@error</div> }
    <div class="form-actions">
        <button type="button" class="btn ghost" @onclick="OnCancel" disabled="@busy">Cancel</button>
        <button type="submit" class="btn primary" disabled="@busy">@(busy ? "Saving..." : Existing is null ? "Save entry" : "Save changes")</button>
    </div>
</form>

@code {
    [Parameter] public EntryRow? Existing { get; set; }
    [Parameter] public string? FixedEmp { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    List<VariableType> types = [];
    string empCode = "", type = "", remarks = "";
    DateTime date = DateTime.Today;
    decimal amount;
    bool busy;
    string? error;

    protected override async Task OnInitializedAsync()
    {
        empCode = FixedEmp ?? "";
        try { types = await Api.VariableTypes() ?? []; } catch { }
        if (Existing is null) return;
        empCode = Existing.EmpCode; type = Existing.Type; date = Existing.Date; amount = Existing.Amount; remarks = Existing.Remarks ?? "";
    }

    async Task Save()
    {
        if (string.IsNullOrEmpty(empCode)) { error = "Select an employee."; return; }
        busy = true; error = null;
        var body = new { empCode, type, date, amount, remarks };
        var r = Existing is null ? await Api.AddVariable(body) : await Api.UpdateVariable(Existing.Id, body);
        busy = false;
        if (r.Ok) await OnSaved.InvokeAsync(); else error = r.Error;
    }
}
