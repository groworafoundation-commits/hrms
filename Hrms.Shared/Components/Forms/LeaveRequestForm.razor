@inject PortalClient Portal

<form class="card rq-form" @onsubmit="Save">
    <header class="rq-fhead">
        <span class="rq-fico"><Icon Name="sun" Size="20" /></span>
        <div><b>Submit New Leave Request</b><small>Fill out your leave application details for your approver's review.</small></div>
        <span class="rq-module">Leave Module</span>
    </header>

    <section class="rq-fsec">
        <h4><i></i> 1. SELECT LEAVE TYPE</h4>
        <div class="rq-two">
            <div class="rq-fld">
                <label><Icon Name="sun" Size="13" /> Leave Type <em>*</em></label>
                <div class="rq-dd">
                    <button type="button" class="rq-dd-btn" @onclick="() => typeOpen = !typeOpen"><span>@(type == "" ? "Select leave type" : TypeName(type))</span><Icon Name="chevron-down" Size="14" /></button>
                    @if (typeOpen)
                    {
                        <div class="rq-back" @onclick="() => typeOpen = false"></div>
                        <div class="rq-dd-panel">
                            <label class="rq-dd-search"><input type="text" placeholder="Search leave type" @bind="typeSearch" @bind:event="oninput" /><Icon Name="search" Size="14" /></label>
                            @foreach (var t in Types.Where(t => string.IsNullOrWhiteSpace(typeSearch) || t.Name.Contains(typeSearch, StringComparison.OrdinalIgnoreCase)))
                            {
                                var code = t.Code;
                                <button type="button" class="rq-dd-opt @(type == code ? "on" : "")" @onclick="() => PickType(code)">
                                    <span>@t.Name</span>
                                    @if (code == "ALVESAL" && balance is { HasPayroll: true }) { <i>Balance: @balance.Available.ToString("0.##")d</i> }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="rq-fld">
                <label><Icon Name="wallet" Size="13" /> Available Leave Quota</label>
                <div class="rq-quota">
                    @if (type == "ALVESAL" && balance is { HasPayroll: true })
                    {
                        <span class="rq-qok"><Icon Name="check" Size="14" /></span>
                        <div class="rq-qname"><b>@TypeName(type)</b><small>As of @(balance.AsOfMonth ?? DateTime.Today.ToString("yyyy-MM"))</small></div>
                        <div class="rq-qmeta">
                            <span>Accrued: @((balance.BroughtForward + balance.Earned).ToString("0.##"))d</span>
                            <span>Used: @((balance.Used + balance.Unprocessed + balance.Pending).ToString("0.##"))d</span>
                            <em class="@(balance.Available < 0 ? "neg" : "")">@balance.Available.ToString("0.##") Day(s) Available</em>
                        </div>
                    }
                    else if (type == "") { <div class="rq-qname"><small>Choose a leave type to see its balance.</small></div> }
                    else { <span class="rq-qok soft"><Icon Name="check" Size="14" /></span><div class="rq-qname"><b>@TypeName(type)</b><small>This leave type has no tracked balance.</small></div> }
                </div>
            </div>
        </div>
        <div class="rq-rules">
            <p>@RouteText</p>
            <span><Icon Name="shield" Size="14" /> Approval Route</span>
        </div>
    </section>

    <section class="rq-fsec">
        <h4><i></i> 2. LEAVE PERIOD</h4>
        <div class="rq-three">
            <div class="rq-fld">
                <label><Icon Name="clock" Size="13" /> Leave Day Portion</label>
                <select class="rq-in" value="@portion" @onchange="PortionChanged">
                    <option value="full">Full Day(s)</option>
                    <option value="half">Half Day</option>
                </select>
            </div>
            <div class="rq-fld">
                <label><Icon Name="calendar" Size="13" /> From Date <em>*</em></label>
                <input class="rq-in" type="date" value="@from.ToString("yyyy-MM-dd")" @onchange="FromChanged" />
            </div>
            <div class="rq-fld">
                <label><Icon Name="calendar" Size="13" /> To Date <em>*</em></label>
                <input class="rq-in" type="date" value="@to.ToString("yyyy-MM-dd")" @onchange="ToChanged" />
            </div>
        </div>
        <div class="rq-total">
            <span><Icon Name="calendar-check" Size="15" /> Calculated Total Leave Days:</span>
            <label class="rq-daypill"><input type="number" step="0.5" min="0.5" value="@days" @onchange="DaysChanged" aria-label="Number of days" /> Day(s)</label>
            <small>Back at work on @to.AddDays(1).ToString("dd MMM yyyy")</small>
        </div>
        @if (type == "ALVESAL" && balance is { HasPayroll: true })
        {
            var after = balance.Available - days;
            <p class="@(after < 0 ? "form-error" : "muted note")">Annual leave available: @balance.Available.ToString("0.##") days. @(after < 0 ? $"This request is {(-after).ToString("0.##")} days more than that, so it would be taken in advance." : $"After this request: {after.ToString("0.##")} days.")</p>
        }
        @if (approvers.Count > 1)
        {
            <div class="rq-fld">
                <label><Icon Name="user-search" Size="13" /> Send to for approval <em>*</em></label>
                <select class="rq-in" @bind="pushTo">
                    <option value="">Select who approves</option>
                    @foreach (var a in approvers) { <option value="@a.Id">@Nice(a.Name) | @a.RoleName (level @a.Level)</option> }
                </select>
            </div>
        }
    </section>

    <section class="rq-fsec">
        <h4><i></i> 3. JUSTIFICATION</h4>
        <div class="rq-two">
            <div class="rq-fld">
                <div class="rq-lblrow"><label><Icon Name="megaphone" Size="13" /> Reason for Leave</label><small>@reason.Length/500 chars</small></div>
                <textarea class="rq-in" rows="3" maxlength="500" placeholder="Tell your approver why you need this leave" @bind="reason" @bind:event="oninput"></textarea>
            </div>
            <div class="rq-fld">
                <div class="rq-lblrow"><label><Icon Name="file" Size="13" /> Additional Remarks <span class="rq-opt">(Optional)</span></label><small>@remarks.Length/500 chars</small></div>
                <textarea class="rq-in" rows="3" maxlength="500" placeholder="Any extra comments or handover notes for your approver" @bind="remarks" @bind:event="oninput"></textarea>
            </div>
        </div>
        <AttachmentPicker @ref="picker" />
    </section>

    @if (error is not null) { <div class="form-error">@error</div> }
    <footer class="rq-ffoot">
        <button type="button" class="rq-fcancel" @onclick="OnCancel" disabled="@busy">Cancel</button>
        <button type="submit" class="rq-fsubmit" disabled="@busy"><Icon Name="arrow-right" Size="14" /> @(busy ? "Sending..." : "Submit Request")</button>
    </footer>
</form>

@code {
    [Parameter] public DateTime? InitialFrom { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<string> OnNote { get; set; }

    AttachmentPicker? picker;

    static readonly (string Code, string Name)[] Types =
    [
        ("LVE", "Annual leave"), ("ALVESAL", "Annual leave with salary"), ("UPL", "Unpaid leave"), ("EMRLVE", "Emergency leave"), ("MTRLVE", "Maternity leave"),
    ];
    static string Nice(string s) => s == s.ToUpperInvariant() || s == s.ToLowerInvariant() ? Fmt.Title(s) : s;
    static string TypeName(string code) => Types.FirstOrDefault(t => t.Code == code).Name ?? code;

    List<Approver> approvers = [];
    LeaveBalance? balance;
    string type = "", pushTo = "", reason = "", remarks = "", portion = "full", typeSearch = "";
    DateTime from = DateTime.Today.AddDays(1), to = DateTime.Today.AddDays(1);
    decimal days = 1;
    bool busy, typeOpen;
    string? error;

    string RouteText => approvers.Count == 0
        ? "No one is above you in the leave chain, so your leave is approved as soon as you send it."
        : approvers.Count == 1
            ? $"Your request goes to {Nice(approvers[0].Name)} ({approvers[0].RoleName}) for approval. They can approve it or pass it to someone senior. You can cancel it until it is approved."
            : "Choose who approves your request. They can approve it or pass it to someone senior. You can cancel it until it is approved.";

    protected override async Task OnInitializedAsync()
    {
        if (InitialFrom is not null) { from = InitialFrom.Value; to = from; }
        try { approvers = await Portal.Approvers() ?? []; } catch { }
        try { balance = await Portal.MyBalance(); } catch { }
        if (approvers.Count == 1) pushTo = approvers[0].Id;
    }

    void PickType(string code) { type = code; typeOpen = false; typeSearch = ""; }

    // a half day is one date and 0.5 days
    void PortionChanged(ChangeEventArgs e)
    {
        portion = e.Value?.ToString() == "half" ? "half" : "full";
        if (portion == "half") { to = from; days = 0.5m; } else Recalc();
    }

    // typing the number of days moves the To date: From + days, counting the first day
    void DaysChanged(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var d) || d <= 0) return;
        days = Math.Min(d, 366);
        portion = days == 0.5m ? "half" : "full";
        to = from.Date.AddDays((double)Math.Max(0, Math.Ceiling(days) - 1));
    }

    void Recalc() { days = Math.Max(1, (decimal)(to.Date - from.Date).TotalDays + 1); if (portion == "half" && to.Date != from.Date) portion = "full"; }
    void FromChanged(ChangeEventArgs e) { if (DateTime.TryParse(e.Value?.ToString(), out var d)) { from = d; if (to < from || portion == "half") to = from; if (portion == "half") days = 0.5m; else Recalc(); } }
    void ToChanged(ChangeEventArgs e) { if (DateTime.TryParse(e.Value?.ToString(), out var d)) { to = d < from ? from : d; portion = "full"; Recalc(); } }

    async Task Save()
    {
        if (string.IsNullOrEmpty(type)) { error = "Choose a leave type."; return; }
        if (string.IsNullOrEmpty(pushTo) && approvers.Count > 0) { error = "Choose who approves this request."; return; }
        busy = true; error = null;
        var r = await Portal.RequestLeave(new { leaveType = type, fromDate = from, toDate = to, days, salaryWithoutLeave = false, pushTo, reason, remarks });
        if (!r.Ok) { busy = false; error = r.Error; return; }
        string? note = null;
        if (picker is { Count: > 0 })
        {
            string? transNo = null;
            try { using var doc = System.Text.Json.JsonDocument.Parse(r.Message ?? "{}"); if (doc.RootElement.TryGetProperty("TransNo", out var t)) transNo = t.GetString(); } catch { }
            note = transNo is null ? "Your request was saved, but its documents could not be attached." : await picker.UploadAll("leave", transNo);
        }
        busy = false;
        if (note is not null) await OnNote.InvokeAsync(note);
        await OnSaved.InvokeAsync();
    }
}
