<span class="avatar" style="width:@(Size)px;height:@(Size)px;font-size:@(Size * 0.38)px;background:@Color">@Initials</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 36;

    static readonly string[] Palette = ["#4f46e5", "#8b5cf6", "#f97316", "#0d9488", "#e11d48", "#0891b2", "#c026d3"];

    string Initials => string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    string Color => Palette[Math.Abs(Name.GetHashCode()) % Palette.Length];
}
