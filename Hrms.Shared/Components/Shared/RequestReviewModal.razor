@inject PortalClient Portal

<Modal Title="@($"{Row.TypeName} request - {Nice(Row.Name ?? Row.EmpCode)}")" OnClose="Close">
    <div class="form">
        <dl class="facts2">
            <div><dt>Request</dt><dd>@Row.TypeName, @When</dd></div>
            <div><dt>Requested</dt><dd>@Fmt.Date(Row.CreatedAt)</dd></div>
            @if (!string.IsNullOrEmpty(Row.Reason)) { <div><dt>Reason</dt><dd>@Row.Reason</dd></div> }
            @if (!string.IsNullOrEmpty(Row.Remarks)) { <div><dt>Remarks</dt><dd>@Row.Remarks</dd></div> }
            @if (opt is not null) { <div><dt>Your level</dt><dd>@opt.Level (final approval at @opt.DocLevel)</dd></div> }
        </dl>
        <AttachmentList OwnerType="request" OwnerKey="@Row.TransNo" />

        @if (opt is null && optError is null) { <p class="muted">Loading...</p> }
        @if (optError is not null) { <div class="form-error">@optError</div> }
        @if (opt is not null)
        {
            <div class="seg">
                <button type="button" class="@(mode == "approve" ? "on" : "")" @onclick='() => mode = "approve"'>@(opt.Final ? "Approve" : "Approve and send up")</button>
                <button type="button" class="@(mode == "reject" ? "on" : "")" @onclick='() => mode = "reject"'>Reject</button>
            </div>
            @if (mode == "approve")
            {
                if (opt.Final) { <p class="muted note">Your approval is final. The request becomes approved.</p> }
                else
                {
                    <label class="field full"><span>Send to (senior to you)</span>
                        <select @bind="to">
                            <option value="">Select a person</option>
                            @foreach (var p in opt.Push) { <option value="@p.Id">@Nice(p.Name) | @p.RoleName (level @p.Level)</option> }
                        </select></label>
                }
                <label class="field full"><span>Note (optional)</span><input type="text" @bind="note" /></label>
            }
            else
            {
                <label class="field full"><span>Reason for rejecting</span><input type="text" @bind="note" /></label>
            }
        }
        @if (actionError is not null) { <div class="form-error">@actionError</div> }
        <div class="form-actions">
            <button type="button" class="btn ghost" @onclick="Close" disabled="@busy">Close</button>
            @if (opt is not null)
            {
                <button type="button" class="btn @(mode == "reject" ? "danger" : "primary")" @onclick="Submit" disabled="@busy">
                    @(busy ? "Saving..." : mode == "reject" ? "Reject request" : opt.Final ? "Approve" : "Approve and send up")
                </button>
            }
        </div>
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public RequestRow Row { get; set; } = default!;
    [Parameter] public EventCallback<string> OnDone { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    RequestOptions? opt;
    string mode = "approve", to = "", note = "";
    bool busy;
    string? optError, actionError;

    static string Nice(string s) => s == s.ToUpperInvariant() || s == s.ToLowerInvariant() ? Fmt.Title(s) : s;

    string When
    {
        get
        {
            var d = Row.FromDate.Date == Row.ToDate.Date ? Fmt.Date(Row.FromDate) : $"{Fmt.Date(Row.FromDate)} - {Fmt.Date(Row.ToDate)}";
            var times = Row.FromTime is { } a && Row.ToTime is { } b ? $", {a:hh\\:mm} - {b:hh\\:mm}" : "";
            var len = Row.Type == "SB" && Row.Minutes is { } m ? $" ({(m >= 60 ? $"{m / 60} h {m % 60} min" : $"{m} min")})" : Row.Type == "SB" ? "" : $" | {Row.Days:0.#} day{(Row.Days == 1 ? "" : "s")}";
            return d + times + len;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { opt = await Portal.ReqOptions(Row.Id); }
        catch (Exception ex) { optError = "Couldn't load the options: " + ex.Message; }
    }

    Task Close() => OnClose.InvokeAsync();

    async Task Submit()
    {
        if (opt is null) return;
        busy = true; actionError = null;
        var r = mode == "reject" ? await Portal.RejectRequest(Row.Id, note) : await Portal.ApproveRequest(Row.Id, opt.Final ? null : to, note);
        busy = false;
        if (!r.Ok) { actionError = r.Error; return; }
        var done = mode == "reject" ? "Rejected" : opt.Final ? "Approved" : "Approved and sent up";
        await OnDone.InvokeAsync($"{done}: {Nice(Row.Name ?? Row.EmpCode)}");
    }
}
